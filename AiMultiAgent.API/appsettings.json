{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "ApiKey": ""
  },
  "Rabbit": {
    "HostName": "rabbitmq",
    "QueueName": "ai_queue",
    "DeadLetterExchange": "ai_dlx",
    "DeadLetterQueueName": "ai_queue.dlq",
    "MaxRetryCount": 3
  },
  "OpenTelemetry": {
    "ServiceName": "AiMultiAgent.API",
    "Otlp": {
      "Endpoint": "",
      "Protocol": "grpc"
    }
  }
}
