# API protection
AI_API_KEY=change-this-api-key

# LLM providers
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# RabbitMQ topology/reliability
RABBIT_HOSTNAME=rabbitmq
RABBIT_QUEUE_NAME=ai_queue
RABBIT_DLX=ai_dlx
RABBIT_DLQ=ai_queue.dlq
RABBIT_MAX_RETRY=3

# Optional Mongo Express credentials
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
